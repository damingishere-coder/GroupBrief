{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 8
    },
    "status": {
      "type": "string",
      "enum": ["success", "failed"]
    },
    "image_path": {
      "type": "string"
    },
    "error": {
      "type": "string"
    }
  },
  "required": ["job_id", "status", "image_path", "error"],
  "additionalProperties": false
}
