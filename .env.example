# ===== GroupBrief V1 配置示例 =====
# 复制本文件为 .env 后填写真实值。.env 不会提交到 Git。

# --- 服务 ---
# 注：8765 被本机其他项目占用，GroupBrief 使用 8766
APP_HOST=127.0.0.1
APP_PORT=8766
APP_TIMEZONE=Asia/Shanghai

# --- 数据库 ---
DATABASE_URL=sqlite:///data/groupbrief.db

# --- 微信历史读取 Provider ---
# 主 Provider：wechat_data_analysis（WeChatDataAnalysis）
# 备用 Provider：wechat_cli（wechat-cli）
HISTORY_PROVIDER_PRIMARY=wechat_data_analysis
HISTORY_PROVIDER_FALLBACK=wechat_cli
HISTORY_PROVIDER_MOCK_ENABLED=true
# 微信数据目录（WeChatDataAnalysis 读取时使用）
WECHAT_DATA_DIR=
# wechat-cli 可执行文件路径（留空则尝试 PATH）
WECHAT_CLI_PATH=

# --- DeepSeek V4 Flash ---
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
CHUNK_MESSAGE_COUNT=60
MAX_CONTEXT_CHARS=12000

# --- 邮件 ---
EMAIL_ENABLED=false
EMAIL_RECIPIENT=
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_USE_SSL=true
EMAIL_SEND_PARTIAL_REPORT=true

# --- 自动任务 ---
SCHEDULE_GENERATE_TIME=08:45
SCHEDULE_EMAIL_TIME=09:00
