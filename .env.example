# ===== GroupBrief v1.0.0 配置示例 =====
# 复制本文件为 .env 后填写真实值。.env 不会提交到 Git。

# --- 服务 ---
# 默认只监听本机 8766 端口。
APP_HOST=127.0.0.1
APP_PORT=8766
APP_TIMEZONE=Asia/Shanghai
# 仅自动化测试或显式本地假数据演练可开启；真实运行必须保持 false。
ALLOW_TEST_PROVIDERS=false
# 旧 V1 数据库流水线默认只读；仅短期回滚/兼容窗口可临时改为 maintenance。
# 该开关不会从数据库或设置 UI 生效。
LEGACY_V1_WRITE_MODE=read_only

# --- 数据库 ---
DATABASE_URL=sqlite:///data/groupbrief.db

# --- V1 兼容历史读取 Provider（正式 V2 固定使用 WeChatDataAnalysis MCP/导出）---
# 不通过生产设置 UI 修改；V1 主/备仍保留一版兼容。
HISTORY_PROVIDER_PRIMARY=wechat_data_analysis
HISTORY_PROVIDER_FALLBACK=wechat_cli
# Mock 必须同时满足 ALLOW_TEST_PROVIDERS=true 才会注册。
HISTORY_PROVIDER_MOCK_ENABLED=false
# 微信数据目录（WeChatDataAnalysis 原始数据探测/状态提示使用，不用于群名解析）
WECHAT_DATA_DIR=
# 微信导出数据目录（WeChatDataAnalysis 结构化 JSON 导出根目录，群名解析与消息读取使用）。
# 留空时使用默认目录 data/wechat_export。
# 目录格式要求：
#   <目录>/groups.json                               群列表（含 group_id / group_name / member_count）
#   <目录>/messages/<安全群ID>/<YYYY-MM-DD>.json     各群每日消息
# 注意：此路径与上面 WECHAT_DATA_DIR（微信原始数据）不同，请分别配置。
WECHAT_EXPORT_DIR=
# wechat-cli 可执行文件路径（留空则尝试 PATH）
WECHAT_CLI_PATH=

# --- WeChatDataAnalysis 本地 MCP 服务（可选，启用后优先于 JSON 导出） ---
# 配置令牌后 GroupBrief 将直接调用本机 WeChatDataAnalysis 服务的 MCP 接口，
# 用于健康检查、群名解析与消息读取；未配置时回退到上面的 WECHAT_EXPORT_DIR。
# 仅允许本机回环地址（如 http://127.0.0.1:10392/mcp），请勿填写远程地址。
WECHAT_MCP_URL=http://127.0.0.1:10392/mcp
# 本地 MCP 服务令牌（必填才能启用 MCP；请勿在此填写真实值）
WECHAT_MCP_TOKEN=
# 可选：微信账号标识（多账号时用于指定读取哪个账号）
WECHAT_MCP_ACCOUNT=
# MCP 请求超时（秒，有界）
WECHAT_MCP_TIMEOUT_SECONDS=10
WECHAT_MCP_RANGE_TIMEOUT_SECONDS=60
# 额外允许的 MCP 主机（逗号分隔，仅 Docker 容器访问宿主机场景使用，
# 如 host.docker.internal）。默认空：仍只允许本机回环地址。
WECHAT_MCP_ALLOWED_HOSTS=

# --- 群聊总结：Codex GPT 主用，DeepSeek 备用 ---
SUMMARY_PROVIDER_PRIMARY=codex
SUMMARY_PROVIDER_FALLBACK=deepseek
CODEX_SUMMARY_MODEL=gpt-5.6-sol
CODEX_SUMMARY_TIMEOUT_SECONDS=240
CODEX_SUMMARY_MAX_RETRIES=2
CODEX_SUMMARY_REQUEST_CONCURRENCY=2

# DeepSeek 备用（只有 SUMMARY_PROVIDER_FALLBACK=deepseek 时才使用）
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
# CHUNK_MESSAGE_COUNT 仅保留旧配置兼容，不再控制实际分段。
CHUNK_MESSAGE_COUNT=60
MAX_CONTEXT_CHARS=50000
GENERATION_GROUP_CONCURRENCY=5
WECHAT_FETCH_CONCURRENCY=3
AI_REQUEST_CONCURRENCY=6

# --- Codex $imagegen（图片生成） ---
# Codex CLI 可执行文件路径（留空则尝试 PATH 中的 codex）。需安装 Codex CLI。
CODEX_PATH=
# Codex 用户目录；认证和 generated_images 必须来自同一目录（留空默认 ~/.codex）。
CODEX_HOME=
# 生图超时（秒）
CODEX_TIMEOUT_SECONDS=1200
# Codex 生成图片目录（留空默认 ~/.codex/generated_images）
CODEX_GENERATED_IMAGES_DIR=

# --- 微信可选发送（实验性；每个群默认关闭） ---
# native：适配微信 4.1.x 的 Windows 键盘/剪贴板/OCR 驱动（默认）；
# legacy_cli：保留旧 wechat-automation-api CLI。
WECHAT_SENDER_MODE=native
# 每个桌面动作后的稳定等待秒数；机器较慢时可适当增大。
WECHAT_NATIVE_ACTION_DELAY_SECONDS=0.6
# 多任务争用微信桌面时的互斥锁等待秒数。
WECHAT_NATIVE_MUTEX_TIMEOUT_SECONDS=20
# 单个发送任务的领取租约（秒）；进程崩溃后会转人工复核，不自动重复发送。
WECHAT_SEND_CLAIM_SECONDS=180
# 到点后的自动补发窗口（分钟）；超过窗口必须显式确认。
WECHAT_LATE_SEND_WINDOW_MINUTES=30
# 以下仅在 WECHAT_SENDER_MODE=legacy_cli 时使用。
# scripts/skill_cli.py 绝对路径
WECHAT_AUTOMATION_CLI_PATH=
# 运行 wechat-automation-api 的 Python（其独立 venv）
WECHAT_AUTOMATION_PYTHON=
# 预留：微信窗口 UIA 类名适配（当前微信 4.1.12 自绘 UI 不兼容，留空自动探测）
WECHAT_WINDOW_CLASS=

# --- 邮件 ---
EMAIL_ENABLED=false
EMAIL_RECIPIENT=
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_USE_SSL=true
EMAIL_SEND_PARTIAL_REPORT=true

# --- 自动任务 ---
# 业务调度统一由后台 APScheduler 管理：每日 00:15 生成前一日群报，08:30 起按群发送。
# 正式环境只能有一个 owner。默认 fastapi；切为 external 前必须先停止内部 scheduler。
SCHEDULER_OWNER=fastapi
SCHEDULE_GENERATE_TIME=00:15
SCHEDULE_EMAIL_TIME=after_generate
SCHEDULE_STARTUP_CATCHUP_ENABLED=true
