# ===== GroupBrief V1 配置示例 =====
# 复制本文件为 .env 后填写真实值。.env 不会提交到 Git。

# --- 服务 ---
# 注：8765 被本机其他项目占用，GroupBrief 使用 8766
APP_HOST=127.0.0.1
APP_PORT=8766
APP_TIMEZONE=Asia/Shanghai

# --- 数据库 ---
DATABASE_URL=sqlite:///data/groupbrief.db

# --- 微信历史读取 Provider ---
# 主 Provider：wechat_data_analysis（WeChatDataAnalysis）
# 备用 Provider：wechat_cli（wechat-cli）
HISTORY_PROVIDER_PRIMARY=wechat_data_analysis
HISTORY_PROVIDER_FALLBACK=wechat_cli
HISTORY_PROVIDER_MOCK_ENABLED=true
# 微信数据目录（WeChatDataAnalysis 原始数据探测/状态提示使用，不用于群名解析）
WECHAT_DATA_DIR=
# 微信导出数据目录（WeChatDataAnalysis 结构化 JSON 导出根目录，群名解析与消息读取使用）。
# 留空时使用默认目录 data/wechat_export。
# 目录格式要求：
#   <目录>/groups.json                               群列表（含 group_id / group_name / member_count）
#   <目录>/messages/<安全群ID>/<YYYY-MM-DD>.json     各群每日消息
# 注意：此路径与上面 WECHAT_DATA_DIR（微信原始数据）不同，请分别配置。
WECHAT_EXPORT_DIR=
# wechat-cli 可执行文件路径（留空则尝试 PATH）
WECHAT_CLI_PATH=

# --- WeChatDataAnalysis 本地 MCP 服务（可选，启用后优先于 JSON 导出） ---
# 配置令牌后 GroupBrief 将直接调用本机 WeChatDataAnalysis 服务的 MCP 接口，
# 用于健康检查、群名解析与消息读取；未配置时回退到上面的 WECHAT_EXPORT_DIR。
# 仅允许本机回环地址（如 http://127.0.0.1:10392/mcp），请勿填写远程地址。
WECHAT_MCP_URL=http://127.0.0.1:10392/mcp
# 本地 MCP 服务令牌（必填才能启用 MCP；请勿在此填写真实值）
WECHAT_MCP_TOKEN=
# 可选：微信账号标识（多账号时用于指定读取哪个账号）
WECHAT_MCP_ACCOUNT=
# MCP 请求超时（秒，有界）
WECHAT_MCP_TIMEOUT_SECONDS=10

# --- DeepSeek V4 Flash ---
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
CHUNK_MESSAGE_COUNT=60
MAX_CONTEXT_CHARS=12000

# --- Codex $imagegen（V2 图片生成） ---
# Codex CLI 可执行文件路径（留空则尝试 PATH 中的 codex）。需安装 Codex CLI。
CODEX_PATH=
# 生图超时（秒）
CODEX_TIMEOUT_SECONDS=600
# Codex 生成图片目录（留空默认 ~/.codex/generated_images）
CODEX_GENERATED_IMAGES_DIR=

# --- 邮件 ---
EMAIL_ENABLED=false
EMAIL_RECIPIENT=
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_USE_SSL=true
EMAIL_SEND_PARTIAL_REPORT=true

# --- 自动任务 ---
SCHEDULE_GENERATE_TIME=08:45
SCHEDULE_EMAIL_TIME=09:00
